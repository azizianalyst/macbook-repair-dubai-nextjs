# ============================================================
# macbook-repair-dubai.ae — static SPA (prerendered) on Hostinger/LiteSpeed
# GENERATED by scripts/build-redirects.cjs — edit the map there, not here.
# ============================================================

Options -MultiViews -Indexes
DirectorySlash Off
RewriteEngine On

# --- Force HTTPS + non-www canonical host ---
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- Block SEO-intelligence crawlers + scrapers (server-level 403) ---
# NOTE: Google, Bing, Apple, Yandex and AI bots are deliberately NOT blocked —
# we want search ranking + AI citations. This only blocks competitor recon tools.
RewriteCond %{HTTP_USER_AGENT} (AhrefsBot|SemrushBot|MJ12bot|DotBot|rogerbot|dataforseo|DataForSeoBot|BLEXBot|MegaIndex|spbot|serpstatbot|Barkrowler|ZoominfoBot|magpie-crawler|SiteAuditBot|linkdexbot|seokicks|sistrix|Cliqzbot|AwarioBot|peer39|trendictionbot) [NC]
RewriteRule ^ - [F,L]

# --- Block access to sensitive / source files (belt-and-suspenders) ---
RewriteRule (^|/)\.(?!well-known)[^/]+ - [F,L]
<FilesMatch "\.(map|env|bak|log|sql|ts|cjs|sh|lock)$">
  Require all denied
</FilesMatch>

# --- Image hotlink protection (allow direct hits, own domain + search engines) ---
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !macbook-repair-dubai\.ae [NC]
RewriteCond %{HTTP_REFERER} !(google|bing|yandex|duckduckgo|wa\.me|whatsapp)\. [NC]
RewriteRule \.(jpg|jpeg|png|webp|avif|gif)$ - [F,NC,L]

# --- Legacy WordPress URLs -> new site (301, preserve rankings) ---
